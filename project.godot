; Engine configuration file.
; Vaelmoor — RPG voxel de fantasía medieval en primera persona (Linux).

config_version=5

[application]

config/name="Vaelmoor"
config/description="RPG de fantasía medieval voxel en primera persona, inspirado en la libertad de los RPG clásicos. Exclusivo para Linux."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="vaelmoor"

[autoload]

Settings="*res://src/autoload/settings.gd"
Events="*res://src/autoload/events.gd"
Audio="*res://src/autoload/audio.gd"
GameState="*res://src/autoload/game_state.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_theme_scale=1.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="actors"
3d_physics/layer_4="projectiles"
3d_physics/layer_5="interactables"
3d_physics/layer_6="pickups"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
anti_aliasing/quality/msaa_3d=1
